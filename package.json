{
  "name": "jetbrains-find-in-files",
  "displayName": "JetBrains Finder for VS Code",
  "description": "Search your workspace with a live results list and code preview.",
  "version": "0.3.66",
  "publisher": "ziishaned",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/ziishaned/jetbrains-finder-for-vscode#readme",
  "bugs": {
    "url": "https://github.com/ziishaned/jetbrains-finder-for-vscode/issues"
  },
  "keywords": [
    "find in files",
    "search",
    "jetbrains"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:jetbrainsFinder.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jetbrainsFinder.open",
        "title": "Find in Files",
        "category": "JetBrains Finder"
      }
    ],
    "keybindings": [
      {
        "command": "jetbrainsFinder.open",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "!inDebugRepl"
      },
      {
        "command": "jetbrainsFinder.quickOpen",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "activeWebviewPanelId == jetbrainsFinder"
      },
      {
        "command": "jetbrainsFinder.quickOpen",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == jetbrainsFinder"
      },
      {
        "command": "jetbrainsFinder.commands",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "activeWebviewPanelId == jetbrainsFinder"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/ripgrep": "^1.18.0",
    "jsonc-parser": "^3.3.1",
    "plist": "^3.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziishaned/jetbrains-finder-for-vscode.git"
  }
}
